#!/bin/sh
# As tools/dk, with a wine prefix of its own (to run two harness runs at once).
cd "$(dirname "$0")/.." || exit 1
exec docker run --rm -i -v civ2-wine2:/wine -v "$PWD":/work -v "${CIV2_GAME:-$HOME/Civ2}":/civ2:ro -e CIV2_GAME=/civ2 \
    -e EXE -e TIMEOUT -e SEED -e JOBS -e CIV2_NORMAL_DESKTOP -e CIV2_TRACE_MSG -e CIV2_APITRACE -e CIV2_CLOCKLOG -e CIV2_TICKCALLERS -e CIV2_LOG_TEXT -e CIV2_RAND_BT -e CIV2_STACKPROBE \
    -w /work civ2-dev "$@"
